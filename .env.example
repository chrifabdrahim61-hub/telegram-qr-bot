# Telegram bot token from @BotFather. NEVER commit your real token.
BOT_TOKEN=123456789:abcdef-your-token-here

# QR rendering options (optional overrides)
QR_ERROR_CORRECTION=M          # L | M | Q | H  (more correction = bigger QR)
QR_BOX_SIZE=10                 # pixel size of each module
QR_BORDER=4                    # quiet-zone modules around the QR

# Safety limits (optional overrides)
MAX_INPUT_LENGTH=1500          # max characters accepted from the user
REQUEST_TIMEOUT=30             # HTTP timeout (seconds) for Telegram API

# Obligatory channel subscription + support contact (optional overrides).
# The bot will refuse to generate QR codes until the user has joined
# REQUIRED_CHANNEL_USERNAME. For this to work, the bot MUST be added as an
# administrator in that channel.
REQUIRED_CHANNEL_USERNAME=@gifthubai
REQUIRED_CHANNEL_URL=https://t.me/gifthubai
SUPPORT_USERNAME=@vxgiyx
